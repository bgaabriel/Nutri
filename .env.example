# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Veja supabase/LEIA-ME.md.

# URL do projeto, ex: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"

# Chave pública (anon / publishable). Pode ficar no front: o acesso aos dados é protegido pelas políticas RLS.
VITE_SUPABASE_ANON_KEY="SUA-CHAVE-ANON"

# NUNCA coloque a service_role key aqui nem em nenhum arquivo do front.
